# Python compiled / cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/

# Data & Output generation
outputs/figures/*.png
outputs/figures/*.pdf
outputs/tables/*.csv
# Report tables and summaries generated by scripts/generate_report_assets.py
outputs/tables/*.tex
outputs/tables/*.md
outputs/tables/*.json
data/results/*.csv
data/results/*.json
# Raw benchmark outputs written by src/analytics/logger.py (CSV + metadata YAML)
data/results/raw/

# Keep placeholder .gitkeep in empty folders
!data/scenarios/.gitkeep
!data/results/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Packaging build artifacts
*.egg-info/
build/
dist/

# Scratch output (smoke runs, playback bundles)
tmp/

# Interactive pipeline viewer pages (scripts/visualize_pipeline.py)
outputs/visualization/

# Team-choice experiment results (scripts/run_team_choice_experiment.py)
data/results/team_choice/
